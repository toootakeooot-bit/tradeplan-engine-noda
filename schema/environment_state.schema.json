{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/noda/environment_state.schema.json",
  "title": "NODA EnvironmentState",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "resolution", "trend", "dow_scales", "lines", "fields", "unresolved"],
  "properties": {
    "stage": {"const": "ENVIRONMENT"},
    "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
    "market_fact_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "significant_high_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "significant_low_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "value", "evidence_refs"],
      "properties": {
        "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
        "value": {"enum": ["UP", "DOWN", "UNDETERMINED", "UNKNOWN"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "turn_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dow_scales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scale", "resolution", "evidence_refs"],
        "properties": {
          "scale": {"enum": ["LARGE", "MIDDLE", "SMALL"]},
          "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_ref", "line_type", "resolution", "evidence_refs"],
        "properties": {
          "line_ref": {"type": "string"},
          "line_type": {"enum": ["HL", "TL", "CH", "TL_ZONE", "INTERMEDIATE_TL", "MIDDLE_DOW_COUNTER_TL"]},
          "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_ref", "resolution", "evidence_refs"],
        "properties": {
          "field_ref": {"type": "string"},
          "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
          "edge_refs": {"type": "array", "items": {"type": "string"}},
          "current_ch_ref": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    },
    "break_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "break_type", "source_ref", "evidence_refs"],
      "properties": {
        "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
        "break_type": {"enum": ["TL_BREAK", "CH_BREAK", "UNKNOWN", "NOT_EVALUATED"]},
        "source_ref": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "field_remap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": {"enum": ["TRUE", "FALSE", "UNKNOWN", "NOT_EVALUATED"]},
        "from_field_ref": {"type": ["string", "null"]},
        "to_field_ref": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tl_ch_break_meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "meaning", "evidence_refs"],
      "properties": {
        "resolution": {"enum": ["KNOWN", "UNKNOWN", "NOT_EVALUATED"]},
        "meaning": {"enum": ["TURN_CANDIDATE", "CONTINUATION_ACCELERATION_CANDIDATE", "UNKNOWN", "NOT_EVALUATED"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string"},
          "description": {"type": "string"},
          "rule_ref": {"type": ["string", "null"]},
          "affected_fields": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
